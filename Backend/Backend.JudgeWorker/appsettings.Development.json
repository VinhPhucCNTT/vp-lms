{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vp-lms;Username=postgres;Password=postgres"
  },
  "AppSettings": {
      "WorkerCount": 5
  },
  "RabbitMq": {
    "BrokerUri": "amqp://guest:guest@localhost:5672/%2f",
    "ContainerId": "judge.worker",
    "QueueName": "judge.submissions",
    "PrefetchCount": 1
  },
  "Judge": {
    "WorkspaceRelativeDir": "judge-workspace",
    "CpuLimit": 1,
    "PidsLimit": 64
  }
}
